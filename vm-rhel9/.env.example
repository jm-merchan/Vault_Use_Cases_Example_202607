# This variant never loads the parent .env token/address.
AWS_REGION=eu-central-1
DOORMAT_AWS_ACCOUNT=aws_jose.merchan_test
EKS_CLUSTER_NAME=eks-infra-dev
KUBE_CONTEXT=arn:aws:eks:eu-central-1:492487827579:cluster/eks-infra-dev
# Optional path to an existing Enterprise license; default ../vault.hclic.
# VAULT_LICENSE_FILE=/absolute/path/vault.hclic
# The Bash supplemental JWT notebook uses KUBE_CONTEXT (EKS).
# It does not switch clusters through OPENSHIFT_CONTEXT or validate OpenShift SCC.

# Public Route 53 zone for the first deployment. Existing deployments keep their recorded zone and subnet order.
DNS_ZONE_NAME=jose-merchan.sbx.hashidemos.io
